  color: #E6B4B4;
}

.favorite.module.odd h3.heading,
.latest.news.module h3.heading span.title,
.random.readings.module h3.heading span.title,
.latest.messages.module h3.heading span.title,
.social.module h3.heading {
  color: #E6B4B4;
  font-variant: small-caps;
}

.latest.news.module h3.heading,
.latest.messages.module.odd h3.heading {
  border-bottom: none;
  background: rgba(14, 19, 11, 0.7);
  border-radius: 10px;
}

div.favorite.module {
  padding: 10px;
  box-sizing: border-box;
  border-radius: 10px;
  background: rgba(14, 19, 11, 0.7);
  box-shadow: none;
}

.splash .favorite li:nth-of-type(2n+1) a,
.splash .favorite li:nth-of-type(2n+2) a {
  background: rgba(14, 19, 11, 0.5);
  border-radius: 10px;
  color: #E6B4B4;
}

.splash .favorite li:nth-of-type(2n+1) a::before,
.splash .favorite li:nth-of-type(2n+2) a::before {
  content: " 🧬 ";
  color: transparent !important;
  text-shadow: 0 0 0 #E6B4B4;
}

.splash .favorite li:nth-of-type(2n+1) a:hover,
.splash .favorite li:nth-of-type(2n+2) a:hover {
  background: #0E130B;
  color: #DED6B8 !important;
}

.splash .favorite li:nth-of-type(2n+1) a:hover::before,
.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " 🍃 ";
  color: transparent !important;
  text-shadow: 0 0 0 #DED6B8;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 80px;
  height: 80px;
  background-image: url("https://64.media.tumblr.com/fe2f1aaacf5996424e5536f477ae66ba/eba70b1bcbee0812-0d/s1280x1920/04a20b06a3845aaa447c40ddf2e12a4982b34c8f.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "𝖍𝖊 𝖜𝖆𝖘 𝖌𝖔𝖔𝖉 𝖎𝖓 𝖇𝖊𝖉, 𝖙𝖍𝖔𝖚𝖌𝖍. 𝖙𝖍𝖊 𝖋𝖑𝖔𝖜𝖊𝖗 𝖇𝖊𝖉. 𝖆𝖘 𝖒𝖚𝖑𝖈𝖍.";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: rgba(14, 19, 11, 0.7);
  text-align: center;
  font-size: 11px;
  color: #E6B4B4;
  opacity: 1;
  white-space: pre;
  border-radius: 10px;
}

.news.index.group li.post.group {
  background: rgba(14, 19, 11, 0.7);
  border-radius: 10px;
  border: 10px solid transparent;
  padding: 0.4em;
