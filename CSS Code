.blurb ul.required-tags,
.blurb ul.required-tags li,
.blurb ul.required-tags li a,
.blurb ul.required-tags li span,
.blurb ul.required-tags li + li + li,
.blurb ul.required-tags li + li + li + li {
  display: block;
  position: unset;
  width: unset;
  height: unset;
  margin: unset;
  padding: unset;
  border: unset;
  background: unset;
  font-size: 1em;
  font-weight: bold;
  text-transform: capitalize;
  line-height: 1;
  color: var(--text);
}

.blurb ul.required-tags {
  display: flex;
